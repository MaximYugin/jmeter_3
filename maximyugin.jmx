              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="random_start &lt;&lt;&lt; JSR223 PreProcessor" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">int totalRecords = vars.get(&quot;total_records&quot;).toInteger()
int sizePage = 25

int totalPages = Math.ceil(totalRecords / sizePage) as int

int randomPage = new Random().nextInt(totalPages) + 1

int startIndex = (randomPage - 1) * sizePage

vars.put(&quot;random_start&quot;, String.valueOf(startIndex))</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>

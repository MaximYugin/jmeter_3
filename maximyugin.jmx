              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="&gt;&gt;&gt; JSR223 Assertion" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def username = vars.get(&quot;username&quot;)
def password = vars.get(&quot;password1&quot;)
def user_id = vars.get(&quot;user_id&quot;)
def responseData = prev.getResponseDataAsString()

if (responseData.contains(&quot;${user_id}&quot;) &amp;&amp; responseData.contains(&quot;${username}&quot;) &amp;&amp; responseData.contains(&quot;was added successfully&quot;)) {
	new File(&quot;users.csv&quot;).append(&quot;${username},${password}\n&quot;)
	log.info(&quot;CSV Сохранилось&quot;)
	
	try {
		def conn = new URL(&quot;http://localhost:8086/write?db=test&quot;).openConnection()
		conn.requestMethod = &quot;POST&quot;
		conn.doOutput = true
		conn.outputStream.withWriter { it &lt;&lt; &quot;users username=\&quot;${username}\&quot;,password=\&quot;${password}\&quot;&quot;}
		def code = conn.responseCode
		log.info(&quot;Данные в InfluxDB сохранились, код ${code}&quot;)
	} catch (Exception e) {
		log.error(&quot;Ошибка в InfluxDB: ${e.message}&quot;)
	}
} else {
	AssertionResult.setFailure(true)
	AssertionResult.setFailureMessage(&quot;Пользователь не был успешно создан&quot;)
	log.warn(&quot;assertion не прошел&quot;)
}		</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>

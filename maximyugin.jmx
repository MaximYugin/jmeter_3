              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="f_key, f_value &lt;&lt;&lt; JSR223 PostProcessor">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def f_dicts = [&quot;assigned_to&quot;: vars.get(&quot;assigned_to&quot;),&quot;queue&quot;: vars.get(&quot;queue&quot;),&quot;status&quot;: vars.get(&quot;status&quot;),&quot;kbitem&quot;: vars.get(&quot;kbitem&quot;)]

def f_list = f_dicts.entrySet() as List
def f_dict  = f_list[new Random().nextInt(f_list.size())]


if (f_dict.key &amp;&amp; f_dict.value) {
    vars.put(&quot;f_key&quot;, f_dict.key)
    vars.put(&quot;f_value&quot;, f_dict.value)
    
    log.info(&quot;Фильтр: ключ = ${f_dict.key}, значение = ${f_dict.value}&quot;)
} else {
    log.info(&quot;Ошибка фильтра&quot;)
}</stringProp>
              </JSR223PostProcessor>

              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="total_records &lt;&lt;&lt; JSON Extractor" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">total_records</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.recordsFiltered</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">ERROR_total_records</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def n = vars.get(&quot;total_records&quot;)
if (n.toInteger() &lt;= 10) {
	AssertionResult.setFailure(true)
	AssertionResult.setFailureMessage(&quot;В системе должно быть заведено более 10 задач&quot;)
}
</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>

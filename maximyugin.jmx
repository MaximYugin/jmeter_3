        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="user_login, user_password &lt;&lt;&lt; JSR223 Sampler" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def url = &quot;http://localhost:8086/query?db=test&amp;q=SELECT+*+FROM+%22users%22&quot;
def text = new URL(url).text

log.info(&quot;Ответ от InfluxDB получен&quot;)

def json = new groovy.json.JsonSlurper().parseText(text)
def users = []

json.results[0].series[0].values.each { m -&gt;
        users.add([password: m[1], login: m[2]])
}

log.info(&quot;Найдено пользователей: &quot; + users.size())

if (users.size() &gt; 0) {
    def i = new Random().nextInt(users.size())
    def user = users[i]
    
    vars.put(&quot;user_login&quot;, user.login)
    vars.put(&quot;user_password&quot;, user.password)
    
    log.info(&quot;Взял из InfluxDB: &quot; + user.login + &quot; / &quot; + user.password)
} else {
    log.info(&quot;В InfluxDB ничего не нашёл&quot;)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
